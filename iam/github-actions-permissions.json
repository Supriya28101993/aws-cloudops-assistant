{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SyncRunbooksBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME"
    },
    {
      "Sid": "WriteRunbookObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME/*"
    },
    {
      "Sid": "SyncKnowledgeBase",
      "Effect": "Allow",
      "Action": ["bedrock:StartIngestionJob", "bedrock:GetIngestionJob"],
      "Resource": "arn:aws:bedrock:us-east-1:YOUR_ACCOUNT_ID:knowledge-base/YOUR_KB_ID"
    }
  ]
}
